# ============================================================
# AEGEA RESERVE — web kökü
#
# Laravel'in standart kuralları + kanonik adres yönlendirmesi.
# NOT: Güvenlik başlıkları burada DEĞİL, App\Http\Middleware\SecurityHeaders
# içinde üretilir (sunucu değişse bile korunsun diye). Buradaki tek istisna
# statik dosyalar: onlar PHP'den geçmediği için nosniff'i burada veriyoruz.
# ============================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ─── KANONİK ADRES ───────────────────────────────────────
    # Dört varyant da (http/https × www'lu/www'suz) ayrı ayrı yayındaydı:
    # arama motoru için kopya içerik, kullanıcı için bölünmüş sepet/oturum.
    # Oturum çerezi `secure` işaretli olduğundan http'de sepet ve giriş
    # sessizce çalışmıyordu. Hepsi tek adrese toplanıyor.
    #
    # Hosting SSL'i vekil sunucuyla sonlandırıyorsa (Cloudflare vb.) %{HTTPS}
    # "off" görünebilir; X-Forwarded-Proto kontrolü o durumda döngüyü önler.
    # SADECE canli alan adinda calisir. Host kosulu olmazsa gelistirme
    # kopyasi (localhost) da canliya firlatilir — bu kural olmadan yerelde
    # calismak imkansiz hale gelir.
    RewriteCond %{HTTP_HOST} (^|\.)ornek-gurme\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://ornek-gurme.com%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.(ornek-gurme\.com)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # ─── Laravel ─────────────────────────────────────────────
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Yanlışlıkla web köküne düşmüş hassas dosyalar ───────────
<FilesMatch "^\.(?!well-known)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(env|log|sql|sqlite|sqlite3|bak|ini|yml|yaml|lock|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ─── Statik dosyalar PHP'den geçmez; nosniff'i burada veriyoruz ───
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|svg|jpe?g|png|gif|webp|avif|ico)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
