#############################################
#  AEGEA RESERVE — CANLI (PRODUCTION) AYARLARI
#  Bu dosyayi sunucuda ".env" olarak yeniden adlandir.
#  ### ile isaretli satirlari MUTLAKA doldur.
#############################################

APP_NAME="AEGEA RESERVE"
APP_ENV=production
APP_KEY=base64:BURAYA_KENDI_ANAHTARINIZI_URETIN
APP_DEBUG=false
### Kendi alan adini yaz (sonunda / OLMAYACAK):
APP_URL=https://ornek-gurme.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

#############################################
# VERITABANI  ### hosting panelinden aldigin bilgiler
#############################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veritabani_adi
DB_USERNAME=veritabani_kullanicisi
DB_PASSWORD=veritabani_sifresi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#############################################
# E-POSTA  ### gercek SMTP bilgileri
# (Bos birakirsan siparis maili GITMEZ, sadece log'a yazilir)
#############################################
MAIL_MAILER=smtp
MAIL_HOST=mail.ornek-gurme.com
MAIL_PORT=587
MAIL_USERNAME=info@ornek-gurme.com
MAIL_PASSWORD=eposta_sifresi
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@ornek-gurme.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#############################################
# IYZICO SANAL POS (kartli odeme)
# Bos kalirsa: sadece havale/EFT + kapida odeme calisir.
# Key girip yonetim > ayarlar'dan "iyzico aktif" yaparsan kart odemesi acilir.
#############################################
IYZICO_API_KEY=
IYZICO_SECRET=
IYZICO_SANDBOX=false
