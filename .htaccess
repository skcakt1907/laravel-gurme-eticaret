# ============================================================
# Alan adı proje köküne bakıyorsa istekleri public/ altına taşır.
# Tercih edilen kurulum docroot = public/ olmasıdır; bu dosya o mümkün
# olmadığında devreye giren yedek çözümdür.
# ============================================================

# Uygulama klasörleri hiçbir koşulda dışarıdan görünmesin.
# (Aşağıdaki rewrite zaten public/ altına taşıyor ve bu yollar 404 veriyor;
#  buradaki kurallar sunucu yapılandırması değişirse diye ikinci hat.)
RewriteEngine On

RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known)  - [F,L]

RewriteRule ^(.*)$ public/$1 [QSA,L]

<FilesMatch "(?i)^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|.*\.sql|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
